# La Verdu - Environment variables
# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# Runtime environment: development | test | production
NODE_ENV=development

# HTTP port for the API
PORT=3000

# Timezone (IANA format). All dates and times use this zone.
TZ_APP=America/Argentina/Buenos_Aires

# Log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Secret for signing admin session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=change_me_in_production

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# PostgreSQL connection string
DATABASE_URL=postgres://laverdu:laverdu_dev_only@localhost:5432/laverdu_dev

# Test database (used by integration tests)
TEST_DATABASE_URL=postgres://laverdu:laverdu_dev_only@localhost:5432/laverdu_test

# ---------------------------------------------------------------------------
# WhatsApp Business Cloud API
# ---------------------------------------------------------------------------

# App secret for webhook signature verification (from Meta App Dashboard)
WHATSAPP_APP_SECRET=

# Verify token for webhook handshake (you choose this, must match Meta config)
WHATSAPP_VERIFY_TOKEN=

# Access token for sending messages (from Meta App Dashboard)
WHATSAPP_ACCESS_TOKEN=

# Phone number ID (from Meta WhatsApp Business setup)
WHATSAPP_PHONE_NUMBER_ID=

# Graph API version
WHATSAPP_API_VERSION=v22.0

# ---------------------------------------------------------------------------
# LLM (Chat model)
# ---------------------------------------------------------------------------

# Profile B (hybrid): hosted OpenAI-compatible API
# Profile A (on-site): local server (Ollama, llama.cpp, vLLM)
CHAT_BASE_URL=http://localhost:8082
CHAT_API_KEY=
CHAT_MODEL=llm-stub

# ---------------------------------------------------------------------------
# STT (Speech-to-text)
# ---------------------------------------------------------------------------

# Profile B (hybrid): hosted OpenAI-compatible Whisper API
# Profile A (on-site): local server (faster-whisper, whisper.cpp)
STT_BASE_URL=http://localhost:8083
STT_API_KEY=
STT_MODEL=stt-stub

# ---------------------------------------------------------------------------
# Backups
# ---------------------------------------------------------------------------

# Directory for database backups
BACKUP_DIR=/var/backups/la-verdu

# Days to keep backups
RETENTION_DAYS=30
