# Local development environment overrides (copy to .env and edit).
# .env is gitignored; never commit real secrets.

# LLM (OpenAI-compatible). For local dev use the stub:
# CHAT_BASE_URL=http://llm-stub:8082
# CHAT_MODEL=llm-stub
# Or a remote provider (e.g. OpenCode):
CHAT_BASE_URL=https://opencode.ai/inference/openai/v1
CHAT_API_KEY=
CHAT_MODEL=gpt-5.4-nano

# STT (OpenAI-compatible). For local dev use the stub:
# STT_BASE_URL=http://stt-stub:8083
# STT_MODEL=stt-stub
STT_BASE_URL=http://stt-stub:8083
STT_API_KEY=
STT_MODEL=stt-stub

# WhatsApp (dev placeholders; must match whatsapp-sim secret)
WHATSAPP_APP_SECRET=local_dev_app_secret_only
WHATSAPP_VERIFY_TOKEN=local_dev_verify_token
WHATSAPP_ACCESS_TOKEN=local_dev_access_token
WHATSAPP_PHONE_NUMBER_ID=1000000000000001
WHATSAPP_API_VERSION=v22.0
