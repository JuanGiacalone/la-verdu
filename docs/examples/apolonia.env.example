# Ejemplo de .env para la instancia "Apolonia"
# Copiar a /opt/la-verdu/.env y completar los valores reales.

NODE_ENV=production
PORT=3000
DATABASE_URL=postgres://laverdu:CONTRASEÑA_SEGURA@127.0.0.1:5432/apolonia
TZ_APP=America/Argentina/Buenos_Aires
LOG_LEVEL=info

SESSION_SECRET=CAMBIAR_POR_SECRETO_LARGO_Y_UNICO

WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v22.0

CHAT_BASE_URL=
CHAT_API_KEY=
CHAT_MODEL=

STT_BASE_URL=
STT_API_KEY=
STT_MODEL=