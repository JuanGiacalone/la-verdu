{
  "name": "la-verdu",
  "version": "0.1.0",
  "private": true,
  "description": "WhatsApp assistant for fruit and vegetable stores (see PRD.md)",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "5.0.5"
  }
}
